{
  "name": "taco-portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TACO ERP original business API on isolated visitor-owned PGlite memory snapshots",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "nest build",
    "spike": "ts-node -P tsconfig.json demo/spike.ts",
    "openapi:demo": "node demo/export-openapi.cjs",
    "lint": "eslint \"src/**/*.ts\" \"demo/**/*.ts\"",
    "test:demo": "node demo/runtime-smoke.cjs && node demo/auth-smoke.cjs && node demo/student-projection-smoke.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "joi": "^17.13.3",
    "light-my-request": "^6.8.0",
    "nodemailer": "10.0.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "typeorm-pglite": "^0.3.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
